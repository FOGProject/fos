+/// convert the size
+char* filesize_conv(double size, char *buf, size_t len) {
+    int i = 0;
+    const char* units[] = {"iB","KiB","MiB","GiB","TiB","PiB","EiB","ZiB","YiB"};
+    while (size > 1024) {
+        size /= 1024;
+        i++;
+    }
+    snprintf(buf, len, "%.*f %s", i, size, units[i]);
+    return buf;
+}
+
+/// write data to log file for status/progress info
+///
+/// Reporting progress is best effort. This used to exit(0) when the file could
+/// not be opened, which quit partclone with a SUCCESS status in the middle of a
+/// restore -- FOG reads that status, sees 0, and records a partially written
+/// partition as a completed deploy. /tmp in FOS is a ramdisk, so a full one is
+/// enough to cause it. Warn once and keep imaging instead: a missing progress
+/// file costs a stalled percentage on the web UI, not the disk.
+void fogLogStatusFile(struct progress_bar *prog,struct prog_stat_t *prog_stat,unsigned long long current) {
+    static int fog_log_warned = 0;
+    FILE *fog_log;
+    fog_log = fopen("/tmp/status.fog","w");
+    if (fog_log == NULL) {
+        if (!fog_log_warned) {
+            fprintf(stderr,"Could not open %s for progress reporting. Imaging continues without progress updates.\n","/tmp/status.fog");
+            fog_log_warned = 1;
+        }
+        return;
+    }
+    double totalsize=prog->block_size * prog->total;
+    double currentsize=prog->block_size * current;
+    char total_str[16];
+    char current_str[16];
+    /* filesize_conv writes into the buffer it is handed and returns it. The
+     * previous form passed that return value as sprintf's FORMAT string, so
+     * any % in the converted text would have been read as a conversion. */
+    filesize_conv(totalsize,total_str,sizeof(total_str));
+    filesize_conv(currentsize,current_str,sizeof(current_str));
+    fprintf(fog_log,"%6.2f%s@%s@%s@%s@%s@%6.2f@%f\n",
+        prog_stat->speed,
+        prog_stat->speed_unit,
+        prog_stat->Eformated,
+        prog_stat->Rformated,
+        current_str,
+        total_str,
+        prog_stat->percent,
+        totalsize
+    );
+    fclose(fog_log);
+}
