+
+#ifdef UDPC_IPV6
+/* Link-local unicast and link-scope multicast addresses only mean
+ * something together with an interface. bind() refuses them without
+ * one. */
+static int needsScope(struct in6_addr *addr) {
+    return IN6_IS_ADDR_LINKLOCAL(addr) || IN6_IS_ADDR_MC_LINKLOCAL(addr) ||
+	IN6_IS_ADDR_MC_NODELOCAL(addr);
+}
+
+/* Parses an IPv6 address with an optional "%scope", as in fe80::1%eth0.
+ * The scope is an interface name or index; it is 0 when not given.
+ * Returns 1 if the text is valid. */
+static int parseIp6(const char *text, struct in6_addr *addr,
+		    uint32_t *scope) {
+    char buffer[INET6_ADDRSTRLEN];
+    const char *percent = strchr(text, '%');
+    size_t len = percent ? (size_t) (percent - text) : strlen(text);
+
+    *scope = 0;
+    if(len >= sizeof(buffer))
+	return 0;
+    memcpy(buffer, text, len);
+    buffer[len] = '\0';
+    if(inet_pton(AF_INET6, buffer, addr) != 1)
+	return 0;
+    if(percent != NULL) {
+	char *end;
+	unsigned long index = strtoul(percent + 1, &end, 10);
+	/* A numeric scope is digits only and fits an interface index.
+	 * strtoul alone would take a sign or spaces, and wrap. */
+	if(isdigit((unsigned char) percent[1]) && *end == '\0') {
+	    if(index == 0 || index > UINT32_MAX)
+		return 0;
+	    *scope = (uint32_t) index;
+	} else
+	    *scope = if_nametoindex(percent + 1);
+	if(*scope == 0)
+	    return 0;
+    }
+    return 1;
+}
+#endif /* UDPC_IPV6 */
