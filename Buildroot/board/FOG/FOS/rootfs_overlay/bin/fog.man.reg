#!/bin/bash
. /usr/share/fog/lib/funcs.sh
. /usr/share/fog/lib/secureboot-funcs.sh
clearScreen
displayBanner
disks=""
disk=""
hd=""
getHardDisk
sysman=""
sysproduct=""
sysversion=""
sysserial=""
sysuuid=""
systype=""
biosversion=""
biosvendor=""
biosdate=""
mbman=""
mbproductname=""
mbversion=""
mbserial=""
mbasset=""
cpuman=""
cpuversion=""
cpucurrent=""
cpumax=""
mem=""
hdinfo=""
caseman=""
casever=""
caseserial=""
caseasset=""
sysman64=""
sysproduct64=""
sysversion64=""
sysserial64=""
sysuuid64=""
systype64=""
biosversion64=""
biosvendor64=""
biosdate64=""
mbman64=""
mbproductname64=""
mbversion64=""
mbserial64=""
mbasset64=""
cpuman64=""
cpuversion64=""
cpucurrent64=""
cpumax64=""
mem64=""
hdinfo64=""
caseman64=""
casever64=""
caseserial64=""
caseasset64=""
dots "Using disk device"
echo $hd
echo " * Starting host registration"
mac=$(getMACAddresses | base64)
sysuuid=$(dmidecode -s system-uuid)
sysuuid=${sysuuid,,}
sysuuid=$(echo $sysuuid | base64)
sysserial=$(dmidecode -s system-serial-number)
sysserial=${sysserial,,}
sysserial=$(echo $sysserial | base64)
# The board serial and chassis asset tag join the UUID and system serial
# so the server can identify this machine by firmware, not only by MAC
# (fogproject #198). A server that does not know the fields ignores them.
mbserial=$(dmidecode -s baseboard-serial-number)
mbserial=${mbserial,,}
mbserial=$(echo $mbserial | base64)
caseasset=$(dmidecode -s chassis-asset-tag)
caseasset=${caseasset,,}
caseasset=$(echo $caseasset | base64)
callServer "${web}service/man.hostexists.php" "sysuuid=${sysuuid}&sysserial=${sysserial}&mbserial=${mbserial}&caseasset=${caseasset}&mac=$mac"
exists="$serverBody"
checkAndSet() {
    local testvar="$1"
    local onlynum="$2"
    [[ -z $testvar ]] && return
    if [[ $onlynum =~ [Tt][Rr][Uu][Ee] && $testvar =~ ^[0-9]+$ ]]; then
        echo $testvar | base64
    elif [[ $testvar =~ ^[0-9,]+$ ]]; then
        echo $testvar | base64
    else
        return
    fi
}
setIDs() {
    local varVar="$1"
    local str="$2"
    local csvstyle="$3"
    local dummy="$4"
    local max="$5"
    local res=""
    local url=""
    local oIFS=$IFS
    local line=""
    while [[ -z ${!varVar} ]]; do
        [[ $csvstyle =~ [Tt][Rr][Uu][Ee] ]] && echo -n "    Enter the $str IDs separated with , to associate with computer (? for listing): " || echo -n "    Enter the $str ID to associate with computer (? for listing): "
        read dummy
        dummy=$(echo $dummy | sed -e 's/^,//' -e 's/,$//')
        case $dummy in
            [?])
                url="${web}service/${str}listing.php"
                clearScreen
                # Unquoted $serverBody, as the original's unquoted $( ) was:
                # the word splitting is what the loop below iterates on.
                # NOTE: this call now follows redirects (callServer uses -L,
                # this site used bare -ks). That is a deliberate improvement --
                # a server that redirects HTTP to HTTPS previously returned the
                # redirect page here and the listing came out as noise.
                callServer "$url"
                res=$(echo -e $serverBody)
                [[ -z $res ]] && res="${serverReason:-no entries returned}"
                i=0
                IFS=$'\n'
                for line in $res; do
                    let i+=1
                    echo $line
                    if [[ $i -eq $max ]]; then
                        [[ $csvstyle =~ [Tt][Rr][Uu][Ee] ]] && echo -n "    Press [Enter] to proceed or enter the $str IDs separated with , to associate with computer: " || echo -n "    Press [Enter] to proceed or enter the $str ID to associate with computer: "
                        read dummy
                        case $dummy in
                            [?]|"")
                                i=0
                                clearScreen
                                continue
                                ;;
                        esac
                        case $csvstyle in
                            [Tt][Rr][Uu][Ee])
                                [[ $dummy =~ ^[0-9,]+$ ]] && printf -v "$varVar" $(checkAndSet $dummy) || setIDs "$varVar" "$str" "$csvstyle" "$dummy" "$max"
                                break
                                ;;
                            *)
                                [[ $dummy =~ ^[0-9]+$ ]] && printf -v "$varVar" $(checkAndSet $dummy "true") || setIDs "$varVar" "$str" "$csvstyle" "$dummy" "$max"
                                break
                                ;;
                        esac
                        i=0
                        dummy=$(echo $dummy | sed -e 's/^,//' -e 's/,$//')
                        clearScreen
                    fi
                done
                ;;
            ""|0)
                printf -v "$varVar" 0
                ;;
            *)
                dummy=$(echo $dummy | sed -e 's/^,//' -e 's/,$//')
                [[ -z $dummy ]] && setIDs "$varVar" "$str" "$csvstyle" "$dummy" "$max"
                case $csvstyle in
                    [Tt][Rr][Uu][Ee])
                        [[ $dummy =~ ^[0-9,]+$ ]] && printf -v "$varVar" $(checkAndSet $dummy) || setIDs "$varVar" "$str" "$csvstyle" "$dummy" "$max"
                        ;;
                    *)
                        [[ $dummy =~ ^[0-9]+$ ]] && printf -v "$varVar" $(checkAndSet $dummy "true") || setIDs "$varVar" "$str" "$csvstyle" "$dummy" "$max"
                        ;;
                esac
                ;;
        esac
    done
    IFS=$oIFS
}
# regfields= names the prompts this screen asks, for example
# regfields=group,image on an iPXE menu entry's args (fogproject#2189). It
# reaches this script as a variable, as every kernel argument does. Unset, every
# prompt is asked, as before. The hostname is always asked: the server needs it.
# Field names: image location ou group snapin productkey domain primaryuser
# other1 other2 deploy.
regShows() {
    [[ -z $regfields || ,${regfields,,}, == *,$1,* ]]
}
# Returns 0 when an optional field should be asked. With regfields set, a
# listed field is asked with no y/N question first, and any other field is
# skipped. Without it, the operator answers "$2 (y/N)" as before.
# deploy and domain are actions, not values: a listed one still asks y/N, so
# a good FOG login alone never starts a deploy or a domain join.
wantField() {
    local field="$1"
    local question="$2"
    local answer=""
    if [[ -n $regfields ]]; then
        regShows "$field" || return 1
        [[ $field == deploy || $field == domain ]] || return 0
    fi
    while true; do
        echo -n "    $question (y/N) "
        read answer
        case $answer in
            [Nn]|[Nn][Oo]|"")
                return 1
                ;;
            [Yy]|[Yy][Ee][Ss])
                return 0
                ;;
            *)
                echo " * Invalid input, please try again"
                ;;
        esac
    done
}
# Sets the variable named $1 to the base64 of the $2 ID(s) the operator picks.
# With regfields set, the pick is a keyboard list of the server's entries:
# a checklist when $3 is true (several IDs), else a menu. Without regfields,
# with no whiptail, or with nothing to list, it is the typed-ID prompt above.
# Esc or Cancel in the list leaves the field empty, which the server reads as
# no association.
askIDs() {
    local varVar="$1"
    local str="$2"
    local csvstyle="$3"
    local line=""
    local choice=""
    local -a items=()
    if [[ -n $regfields ]] && command -v whiptail >/dev/null 2>&1; then
        callServer "${web}service/${str}listing.php"
        # The listing writes \t and \n as literal escapes; echo -e expands them.
        while IFS= read -r line; do
            [[ $line =~ ID#\ ([0-9]+)[[:space:]]+-[[:space:]]+(.*)$ ]] || continue
            items+=("${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}")
            [[ $csvstyle =~ [Tt][Rr][Uu][Ee] ]] && items+=("OFF")
        done <<< "$(echo -e "$serverBody")"
    fi
    if [[ ${#items[@]} -eq 0 ]]; then
        setIDs "$varVar" "$str" "$csvstyle" "" 20
        return
    fi
    local kind="--menu"
    local prompt="Select the $str for this computer."
    if [[ $csvstyle =~ [Tt][Rr][Uu][Ee] ]]; then
        kind="--checklist"
        prompt="Select the ${str}s for this computer. Space marks one, Enter accepts."
    fi
    # whiptail draws on stdout and prints the choice on stderr; swap the two.
    # A checklist prints one ID per line; join them with commas.
    choice=$(whiptail --title "FOG Registration" --separate-output "$kind" "$prompt" 20 70 12 "${items[@]}" 3>&1 1>&2 2>&3)
    choice=$(echo $choice | tr ' ' ',')
    printf -v "$varVar" '%s' "$(checkAndSet "$choice")"
}
[[ $exists != "#!ok" ]] && handleError "Unable to register host: $exists ($0)\n   Args Passed: $*"
host=""
ip=""
productKey=""
imageid=""
primaryuser=""
other1=""
other2=""
blImage=""
blDoAddGroup=""
blDoAddSnapin=""
keyEnter=""
blDoAD=""
user64=""
pass64=""
fogAuthed=""
# Asks for a FOG GUI login until the server accepts it, three tries at most.
# On success sets user64/pass64 for the registration POST and fogAuthed=1,
# and returns 0. Asks nothing again once a login was accepted.
# Both domain join and imaging need it: the server copies the domain join
# account onto the new host only for a signed-in operator
# (GHSA-97vv-f7hc-rp5m).
fogLogin() {
    [[ -n $fogAuthed ]] && return 0
    local ret=""
    local retry=3
    # Local, so the plaintext password does not outlive this function.
    local username=""
    local password=""
    while [[ ! $retry -eq 0 ]]; do
        echo " * Enter FOG GUI Username and Password"
        echo -n "    Username: "
        # read trims leading and trailing blanks, as the web UI trims every
        # posted value, so the two agree on what the password is.
        read -r username
        echo -n "    Password: "
        read -rs password
        # Quoted printf, not a bare echo: word splitting and globbing changed
        # a password holding spaces, '*' or '?', or one spelled -n or -e, so a
        # correct login read as invalid. The tr joins base64's 76-column wrap.
        user64=$(printf '%s' "$username" | base64 | tr -d '\n')
        pass64=$(printf '%s' "$password" | base64 | tr -d '\n')
        callServer "${web}service/checkcredentials.php" "sysuuid=${sysuuid}&mac=$mac&username=$user64&password=$pass64"
        ret="${serverBody:-$serverReason}"
        case $ret in
            '#!ok')
                echo
                fogAuthed=1
                return 0
                ;;
            '#!il')
                let retry-=1
                echo
                echo " * Error: Invalid Login! ($retry remaining)"
                ;;
            '#!rl')
                # The server rate limits this endpoint after
                # repeated bad credentials and answers '#!rl'
                # until the window expires. Without this case it
                # fell through to "Unexpected response from
                # server", which sends the user looking for a
                # network fault instead of waiting.
                let retry-=1
                echo
                echo " * Error: Too many failed logins. Wait a few minutes and try again."
                ;;
            *)
                let retry-=1
                echo
                echo " * Error: Unexpected response from server ($retry remaining)"
                ;;
        esac
    done
    # A rejected login must not reach the registration POST.
    user64=""
    pass64=""
    return 1
}
res=""
while [[ $res != "#!ok" ]]; do
    echo -n " * Enter hostname for this computer: "
    read host
    if [[ ${#host} -gt 15 ]]; then
        host=${host:0:15}
        echo " | Truncated to 15 characters: $host"
        usleep 2000000
    fi
    host=$(echo $host | base64)
    callServer "${web}service/hostnameloop.php" "host=$host"
    res="$serverBody"
    # ${serverReason:-$res}: a failed call printed a blank line and asked for the
    # hostname again, forever, with no hint that the server was the problem.
    [[ $res != "#!ok" ]] && echo "${serverReason:-$res}"
done
imageid=""
regShows image && askIDs "imageid" "image" ""
# The prompt is offered only when the server says "##". A failed call is not
# "##" either, so this used to skip the question in silence and register the
# host with no location. Return 2 (answered, empty body) is a legitimate "no
# locations configured" here and stays quiet; only a real failure is reported,
# and the default is unchanged so the flow is not blocked by a warning.
if regShows location; then
    callServer "${web}service/locationcheck.php"
    [[ $? -eq 1 ]] && echo " * Could not ask the server about locations: ${serverReason}"
    if [[ $serverBody == "##" ]] && wantField location "Would you like to assign a location for this host?"; then
        askIDs "locationid" "location" ""
        location64=$locationid
    fi
fi
if regShows ou; then
    callServer "${web}service/oucheck.php"
    [[ $? -eq 1 ]] && echo " * Could not ask the server about OUs: ${serverReason}"
    if [[ $serverBody == "##" ]] && wantField ou "Would you like to assign an ou for this host?"; then
        askIDs "ouid" "ou" ""
        ou64=$ouid
    fi
fi
if wantField group "Would you like to associate this host with groups?"; then
    askIDs "groupid" "group" "true"
    group64=$groupid
fi
if wantField snapin "Would you like to associate this host with snapins?"; then
    askIDs "snapinid" "snapin" "true"
    snapin64=$snapinid
fi
if wantField productkey "Would you like to associate a product key to this host?"; then
    echo -n " * Enter the product key for this computer: "
    read productKey
    productKey=$(echo $productKey | base64)
fi
if wantField domain "Would you like this host to join a domain, (using default settings)?"; then
    if fogLogin; then
        blDoAD=$(echo -n 1 | base64)
    else
        echo " * This host will be registered without joining a domain."
    fi
fi
if regShows primaryuser; then
    echo -n " * Enter the primary user for this computer: "
    read primaryuser
    primaryuser=$(echo $primaryuser | base64)
fi
if regShows other1; then
    echo -n " * Enter the other tag #1 for this computer: "
    read other1
    other1=$(echo $other1 | base64)
fi
if regShows other2; then
    echo -n " * Enter the other tag #2 for this computer: "
    read other2
    other2=$(echo $other2 | base64)
fi
echo " * You entered all required information, "
if wantField deploy "Would you like to deploy image to this computer now?"; then
    if fogLogin; then
        echo " * Deployment will start (this host may reboot first)"
        realdoimage=$(echo -n 1 | base64)
    else
        echo " * This host will be registered without deploying an image."
    fi
fi
dots "Attempting to register host"
res=""
# Unbounded on purpose -- registration is the whole point of this screen and
# there is a human present to abort -- but it used to echo an empty line every
# two seconds when the server was unreachable, so the operator watched a blank
# console with no idea anything was wrong.
while [[ -z $res ]]; do
    callServer "${web}service/auto.register.php" "sysuuid=${sysuuid}&sysserial=${sysserial}&mbserial=${mbserial}&caseasset=${caseasset}&mac=$mac&advanced=$(echo -n 1 | base64)&host=$host&imageid=$imageid&primaryuser=$primaryuser&other1=$other1&other2=$other2&doimage=$realdoimage&doad=$blDoAD&location=$location64&ou=$ou64&username=$user64&password=$pass64&groupid=$group64&snapinid=$snapin64&productKey=$productKey"
    res="$serverBody"
    echo "${serverReason:-$res}"
    usleep 2000000
done
. /bin/fog.inventory
# After the host is registered and inventoried, so a failed enrollment costs
# neither. Does nothing unless sbenroll=true; see sbEnrollAtRegistration().
sbEnrollAtRegistration
# Deploy now without a reboot when the server says the next boot would be the
# same as this one. Returns at once otherwise, and the host reboots as before.
[[ $realdoimage == "$(echo -n 1 | base64)" ]] && continueIntoTask
usleep 2000000
