#!/bin/bash
. /usr/share/fog/lib/funcs.sh
. /usr/share/fog/lib/secureboot-funcs.sh
clearScreen
displayBanner

cert="/tmp/MOK.der"

echo " * Enrolling this machine's FOG Secure Boot certificate"
echo

dots "Checking firmware state"
state=$(sbState)
echo "$state"
debugPause

case $state in
    nonefi)
        # Not a failure of this task so much as a task pointed at the wrong
        # machine, but it is still a task that cannot do what it was asked to.
        # Per ADR-0003 that aborts rather than reporting a success that enrolled
        # nothing.
        handleError "This machine booted in BIOS/CSM mode, where Secure Boot does not exist. ($0)\n   Nothing was enrolled. Switch the firmware to UEFI and run this again."
        ;;
    noefivars)
        handleError "UEFI firmware was detected but efivarfs could not be mounted. ($0)\n   FOS cannot read or write EFI variables, so nothing was enrolled."
        ;;
esac

# 32-bit UEFI is refused outright rather than degraded to the db path. See
# docs/adr/0009-secure-boot-enrolment-paths.md and FOGProject/fos#140.
#
# The db write would succeed -- nothing in it is architecture-specific -- and
# that is precisely the trap. No Microsoft-signed 32-bit shim and no signed
# 32-bit iPXE exist, so this machine cannot boot FOG under Secure Boot
# enforcement whether or not the certificate is enrolled. Meanwhile the only
# state where this task can run on ia32 at all is Setup Mode (nothing is
# enforcing, so the unsigned chain boots), and the last thing the db path does
# is write the PK -- which is what LEAVES Setup Mode. Degrading would therefore
# take a machine FOG can image today, make it enforceable, and leave it with
# nothing signed to boot, irreversibly from the client's side.
#
# Checked before the certificate fetch and before the already-trusted
# short-circuit: no db contents make enrollment useful here, so there is no state
# in which continuing tells the admin something more useful than this does.
if [[ $(sbPlatformBits) == 32 ]]; then
    handleError "This machine has 32-bit UEFI firmware, which FOG cannot enroll. ($0)\n   No Microsoft-signed 32-bit shim and no signed 32-bit iPXE exist, so it\n   cannot boot FOG under Secure Boot enforcement even with this key trusted.\n   Nothing was enrolled and nothing was changed. Leave Secure Boot off here."
fi

dots "Fetching certificate"
if ! sbFetchCert "$cert"; then
    echo "Failed"
    debugPause
    handleError "Could not download a usable certificate from ${web}service/secureboot/MOK.der ($0)\n   Secure Boot signing may not be configured on this FOG server;\n   check the Secure Boot page under FOG Configuration."
fi
echo "Done"
debugPause

# Shown and reported for the record, not as a security gate: FOS is already
# running a kernel this same server signed and served, so a server that could
# hand us the wrong certificate could equally have handed us the wrong kernel.
# The value of it is that it matches what the Secure Boot page displays and
# what sbReport stores against the host, so an enrollment can be audited after
# the fact -- "enrolled in March" says nothing about whether this machine
# trusts what the server is serving today, and a fingerprint does.
fingerprint=$(sbCertFingerprint "$cert")
echo " * Certificate SHA-256:"
echo "     $fingerprint"
echo

if sbCertTrusted "$cert"; then
    echo " * This certificate is already trusted by this machine. Nothing to do."
    echo
    # Reported even though this task enrolled nothing. "This machine already
    # trusts the certificate the server is serving today" is the answer the
    # administrator was after; recording nothing would leave the host looking
    # never-enrolled and invite the same task again on the next sweep.
    sbReport "trusted" "$fingerprint"
    . /bin/fog.nonimgcomplete
    exit 0
fi

if [[ $state == setup ]]; then
    # The automatic path. Preferred over staging a MOK whenever it is available,
    # because it finishes here: no reboot into MokManager, no password, nobody
    # at the keyboard. Only reachable in Setup Mode -- see sbState().
    echo " * This machine is in Setup Mode, so its Secure Boot databases can be"
    echo "   written directly. Enrolling automatically; no MOK Manager step is"
    echo "   needed."
    echo
    dots "Enrolling Secure Boot keys"
    if ! sbEnrollDb; then
        echo "Failed"
        debugPause
        # Deliberately spells out the state the machine is left in. A partial
        # enrollment stops before the PK write, so the platform is still in Setup
        # Mode and still boots exactly what it booted before -- that is worth
        # saying, because "Secure Boot enrollment failed" otherwise reads like
        # the machine may now be unbootable, and someone will make an
        # unnecessary trip to the firmware screen to check.
        handleError "Automatic Secure Boot enrollment failed. ($0)\n   This machine is still in Setup Mode and still boots as it did before;\n   nothing has been made unbootable.\n   Check that ${web}service/secureboot/ serves PK.auth, KEK.auth and db.auth --\n   the FOG server needs efitools installed to produce them."
    fi
    echo "Done"
    debugPause

    echo
    echo "=============================================================================="
    echo " Secure Boot is now enrolled on this machine."
    echo
    echo "   This FOG server's certificate is in the platform's db, and Microsoft's"
    echo "   certificates were enrolled alongside it, so Windows and FOG's own"
    echo "   signed PXE chain both still boot."
    echo
    echo " The machine has left Setup Mode. Secure Boot enforcement takes effect on"
    echo " the next boot; turn it on in the firmware if it is not already."
    echo "=============================================================================="
    echo

    sbReport "db" "$fingerprint"
    . /bin/fog.nonimgcomplete
    exit 0
fi

password=$(sbMokPassword)
if [[ -z $password ]]; then
    handleError "Could not determine a one-time password for the MOK request. ($0)"
fi

dots "Staging MOK enrollment request"
if ! sbStageMok "$cert" "$password"; then
    echo "Failed"
    debugPause
    handleError "The MOK enrollment request was NOT staged. ($0)\n   Do not reboot expecting a MokManager prompt; nothing is pending.\n   See the messages above for what ran."
fi
echo "Done"
debugPause

echo
echo "=============================================================================="
echo " A Secure Boot enrollment request is now pending on this machine."
echo
echo "   ONE-TIME PASSWORD:   $password"
echo
echo " On the next boot, a blue MOK Manager screen appears instead of the normal"
echo " boot. Work through it in this order:"
echo
echo "   1. Enroll MOK"
echo "   2. View key 0        <- check it names your FOG server"
echo "   3. Continue"
echo "   4. Yes"
echo "   5. Enter the password above"
echo "   6. Reboot"
echo
echo " If MOK Manager does NOT appear, this machine did not boot through a shim"
echo " and nothing has been enrolled."
echo "=============================================================================="
echo

# "mok", NOT "db": nothing is enrolled yet and will not be until a human works
# through MokManager. The server records this as pending for exactly that
# reason -- see ADR 0029 decision 6.
sbReport "mok" "$fingerprint"
. /bin/fog.nonimgcomplete
