#!/bin/bash
. /usr/share/fog/lib/funcs.sh
. /usr/share/fog/lib/secureboot-funcs.sh
clearScreen
displayBanner

echo " * Enrolling this machine's FOG Secure Boot certificate"
echo

# The steps live in sbEnroll() so registration can run them too (see
# fogproject#1860). handleError keeps this task's behavior: any failure aborts
# it, so it never reports a success that enrolled nothing (ADR-0003).
sbEnroll handleError

# Reported BEFORE the task is completed: fog.nonimgcomplete clears the task,
# and the endpoint refuses a report once no enrollment task is in flight. The
# outcome is sbEnroll's own -- "mok" for a staged request is what stops the
# server recording a machine as enrolled when a human has yet to confirm it.
sbReport "$sbOutcome" "$sbFingerprint"
. /bin/fog.nonimgcomplete
