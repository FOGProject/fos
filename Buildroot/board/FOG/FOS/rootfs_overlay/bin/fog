#!/bin/bash
. /usr/share/fog/lib/funcs.sh
### If USB Boot device we need a way to get the kernel args properly
if [[ $boottype == usb && ! -z $web ]]; then
    # The key and hostinfo requests are shared with continueIntoTask() in
    # funcs.sh. It sets $sysuuid, says so when no key came back, and writes the
    # reply to /tmp/hinfo.txt with mode 0600.
    fetchHostInfo
    mac="$hostInfoMac"
    [[ -f /tmp/hinfo.txt ]] && . /tmp/hinfo.txt
fi
dots "Running post init scripts"
[[ ! -d /imagesinit ]] && mkdir /imagesinit >/dev/null 2>&1
umount /imagesinit >/dev/null 2>&1
# -t nfs is load-bearing, and proto= must stay out. See the comments in fog.mount.
mount -t nfs -o nolock,rsize=32768,wsize=32768,intr,noatime "$storage" /imagesinit >/tmp/mount-output 2>&1
if [[ $? -eq 0 ]]; then
    if [[ -f /imagesinit/.mntcheck ]]; then
        if [[ -f /imagesinit/postinitscripts/fog.postinit ]]; then
            postinitpath="/imagesinit/postinitscripts/"
        elif [[ -f /imagesinit/dev/postinitscripts/fog.postinit ]]; then
            postinitpath="/imagesinit/dev/postinitscripts/"
        fi
        . ${postinitpath}fog.postinit
    fi
    umount /imagesinit >/dev/null 2>&1
    echo "Done"
    debugPause
else
    echo "Skipped"
    debugPause
fi
if [[ -n $mode && $mode != +(*debug*) && -z $type ]]; then
    case $mode in
        wipe)
            fog.wipe
            ;;
        checkdisk)
            fog.testdisk
            ;;
        photorec)
            fog.photorec
            ;;
        badblocks)
            fog.surfacetest
            ;;
        autoreg)
            fog.auto.reg
            ;;
        manreg)
            fog.man.reg
            ;;
        inventory)
            fog.inventory
            ;;
        capone)
            fog.capone
            ;;
        winpassreset)
            fog.chntpw
            ;;
        quickimage)
            fog.quickimage
            ;;
        sysinfo)
            fog.sysinfo
            ;;
        enrollsb)
            fog.enrollsb
            ;;
        enrollsbforce)
            fog.enrollsbforce
            ;;
        perftest)
            fog.perftest
            ;;
        *)
            handleError "Fatal Error: Unknown mode :: $mode ($0)\n   Args Passed: $*"
            ;;
    esac
else
    case $type in
        down)
            fog.download
            ;;
        up)
            fog.upload
            ;;
        *)
            [[ -z $type ]] && type="Null"
            handleError "Fatal Error: Unknown request type :: $type"
            ;;
    esac
fi
